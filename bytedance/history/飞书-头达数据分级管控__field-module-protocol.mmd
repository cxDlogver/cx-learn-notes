flowchart LR
    A["字段级与模块级权限协议"] --> F["字段级权限"]
    A --> M["模块级权限"]

    F --> F1["复用原业务接口"]
    F1 --> F2["后端在返回前<br/>转换受控字段"]
    F2 --> F3{"原字段返回值"}
    F3 -- "正常值" --> F4["正常展示"]
