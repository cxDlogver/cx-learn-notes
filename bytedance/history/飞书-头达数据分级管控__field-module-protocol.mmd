    F5 --> F6{"payload"}
    F6 -- "888" --> F7["缺少协作人"]
    F6 -- "999" --> F8["需要点击查看"]
    F6 -- "普通 front_key" --> F9["缺少数据权限"]
    F9 --> F10["front_key 标识<br/>对应的数据维度权限"]

    M --> M2["调用 employee_permission<br/>查询模块权限"]
    M2 --> M3["has_permission<br/>need_eyes<br/>is_coo"]
    M3 -- "has_permission=true<br/>need_eyes=false" --> M4["正常展示"]
    M3 -- "has_permission=true<br/>need_eyes=true" --> M5["需要点击查看"]
    M3 -- "has_permission=false<br/>is_coo=true" --> M6["缺少数据权限"]
    M6 --> M8["模块提前约定<br/>对应的数据维度权限"]
    M3 -- "has_permission=false<br/>is_coo=false" --> M7["缺少协作人"]

