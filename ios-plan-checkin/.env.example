APP_ENV=development
API_PORT=3000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
PLAN_CHECKIN_POSTGRES_PORT=5432
PLAN_CHECKIN_REDIS_PORT=6379
PLAN_CHECKIN_OBJECT_PORT=9000
API_TRUST_PROXY_HOPS=0
API_METRICS_TOKEN=local_only_replace_for_development
DATABASE_URL=postgresql://plan_checkin:local_only_change_me@127.0.0.1:5432/plan_checkin
REDIS_URL=redis://127.0.0.1:6379/0
OBJECT_ENDPOINT=http://127.0.0.1:9000
OBJECT_PUBLIC_ENDPOINT=http://127.0.0.1:9000
OBJECT_REGION=us-east-1
OBJECT_BUCKET=plan-checkin-local
OBJECT_ACCESS_KEY_ID=localdev
OBJECT_SECRET_ACCESS_KEY=local_only_change_me
SMS_PROVIDER=stub
PUSH_PROVIDER=stub
ACCESS_TOKEN_SECRET=local_only_replace_for_development
PHONE_ENCRYPTION_KEY=local_only_replace_for_development
PHONE_LOOKUP_KEY=local_only_replace_for_development
OTP_HASH_KEY=local_only_replace_for_development
AUTH_IDEMPOTENCY_KEY=local_only_replace_for_development
PUSH_TOKEN_ENCRYPTION_KEY=local_only_replace_for_development
# Generate one P-256 VAPID pair; expose only the public key to the API/browser.
# VAPID_PUBLIC_KEY=<uncompressed P-256 point, base64url>
# VAPID_PRIVATE_KEY=<32-byte scalar, base64url; Worker only>
# VAPID_SUBJECT=mailto:push@example.com
APNS_PROVIDER=stub
APNS_ENV=sandbox
# APNS_PROVIDER=apns requires APNS_BUNDLE_ID, APNS_TEAM_ID, APNS_KEY_ID and
# APNS_PRIVATE_KEY_BASE64 (base64 of the Apple .p8 file) in the Worker environment.
