{
  "name": "@plan-checkin/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "serve": "node server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "@plan-checkin/contracts": "workspace:*",
    "@plan-checkin/design-tokens": "workspace:*",
    "@plan-checkin/domain": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.4",
    "@types/react-dom": "^19.3.0",
    "vite": "^8.3.1"
  }
}
