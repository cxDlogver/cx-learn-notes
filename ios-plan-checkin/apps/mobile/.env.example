# iOS simulator: local API. Physical devices use the computer's reachable LAN address.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/api/v1
# Development-only navigation/data fixture switch. Never enable in release builds.
EXPO_PUBLIC_USE_MOCK_REPOSITORY=0
# 发布构建需填写真实、可访问的协议页面 HTTPS 地址。
# EXPO_PUBLIC_TERMS_URL=https://your-domain.example/terms
# EXPO_PUBLIC_PRIVACY_URL=https://your-domain.example/privacy
