{
  "contractVersion": 1,
  "decisionId": "ADR-001",
  "system": "personal-knowledge-agent",
  "dataClasses": [
    {
      "id": "business-records",
      "canonicalStore": "postgres-app-schema",
      "scope": "workspace",
      "authoritativeFor": [
        "identity-and-membership",
        "document-catalog",
        "run-projection",
        "proposal-and-approval",
        "idempotency",
        "outbox",
        "audit"
      ],
      "mustNotBeAuthoritativeFor": [
        "graph-resume-position",
        "bullmq-delivery-state"
      ]
    },
    {
      "id": "graph-state",
      "canonicalStore": "langgraph-checkpoint",
      "scope": "thread",
      "authoritativeFor": [
        "node-inputs-and-outputs",
        "pending-interrupt",
        "graph-resume-position"
      ],
      "mustNotBeAuthoritativeFor": [
        "authorization",
        "document-content",
        "approval-audit",
        "idempotent-side-effect-result"
      ]
    },
    {
      "id": "checkpoint",
      "canonicalStore": "postgres-langgraph-checkpoint-schema",
      "scope": "thread",
      "authoritativeFor": [
        "durable-graph-snapshot",
        "interrupt-resume"
      ],
      "mustNotBeAuthoritativeFor": [
        "business-run-status",
        "knowledge-retrieval",
        "user-permissions"
      ]
    },
    {
      "id": "cross-thread-memory",
      "canonicalStore": "postgres-langgraph-store-schema",
      "scope": "principal-or-workspace",
      "authoritativeFor": [
        "approved-user-preferences",
        "cross-thread-agent-memory"
      ],
      "mustNotBeAuthoritativeFor": [
        "source-document-content",
        "graph-resume-position",
        "authorization"
      ]
    },
    {
      "id": "document-content",
      "canonicalStore": "postgres-document-versions",
      "scope": "knowledge-base",
      "authoritativeFor": [
        "approved-version-content",
        "content-hash",
        "materialization-intent"
      ],
      "mustNotBeAuthoritativeFor": [
        "embedding-nearest-neighbor-results",
        "queue-delivery"
      ]
    },
    {
      "id": "filesystem-projection",
      "canonicalStore": "allowlisted-knowledge-root",
      "scope": "knowledge-base",
      "authoritativeFor": [
        "materialized-repository-file"
      ],
      "mustNotBeAuthoritativeFor": [
        "approval-decision",
        "idempotency",
        "run-status"
      ]
    },
    {
      "id": "embeddings",
      "canonicalStore": "postgres-pgvector",
      "scope": "document-version",
      "authoritativeFor": [
        "chunk-text-and-location",
        "embedding-vector",
        "retrieval-source-link"
      ],
      "mustNotBeAuthoritativeFor": [
        "approved-document-version",
        "authorization"
      ]
    },
    {
      "id": "queue-delivery",
      "canonicalStore": "redis-bullmq",
      "scope": "job",
      "authoritativeFor": [
        "attempt-count",
        "backoff",
        "worker-lease",
        "delivery-status"
      ],
      "mustNotBeAuthoritativeFor": [
        "business-intent",
        "approved-version-content",
        "audit-history"
      ]
    }
  ],
  "trustBoundaries": [
    {
      "id": "browser-to-api",
      "inputTrust": "untrusted",
      "enforcedBy": "nestjs-auth-validation-and-rate-limit"
    },
    {
      "id": "prompt-and-documents-to-model",
      "inputTrust": "untrusted",
      "enforcedBy": "context-labeling-and-tool-policy"
    },
    {
      "id": "model-to-tools",
      "inputTrust": "untrusted",
      "enforcedBy": "deterministic-tool-gateway"
    },
    {
      "id": "api-to-filesystem",
      "inputTrust": "privileged-after-checks",
      "enforcedBy": "allowlist-realpath-membership-and-optimistic-version"
    }
  ],
  "sideEffects": [
    {
      "id": "materialize-approved-file",
      "authority": "deterministic-tool-gateway",
      "approvalRequired": true,
      "idempotencyKey": "proposal-operation-key",
      "precondition": "current-file-hash-equals-base-hash-or-target-hash",
      "delivery": "postgres-outbox-to-bullmq",
      "recovery": "target-hash-means-already-applied; base-hash-means-safe-to-apply; otherwise-conflict"
    },
    {
      "id": "index-document-version",
      "authority": "index-worker",
      "approvalRequired": false,
      "idempotencyKey": "document-version-id",
      "precondition": "version-is-materialized",
      "delivery": "postgres-outbox-to-bullmq",
      "recovery": "upsert-chunks-by-version-and-chunk-index"
    }
  ],
  "modelPolicy": {
    "may": [
      "classify-user-intent",
      "select-read-only-retrieval-tool",
      "draft-analysis",
      "draft-change-proposal"
    ],
    "mustNot": [
      "grant-permission",
      "expand-knowledge-root",
      "approve-own-change",
      "write-files-directly",
      "choose-idempotency-outcome",
      "treat-retrieved-document-as-system-instruction"
    ]
  }
}
