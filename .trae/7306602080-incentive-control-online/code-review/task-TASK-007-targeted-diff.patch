+++ b/apps/alliance-operation-content/src/routes/content-activity/award/utils.ts
@@ -1,8 +1,18 @@
 import NP from 'number-precision';
+import { MESSAGES } from './constants';
 
 const kSecondsPerHour = 3600;
 const kHalfHourScale = 2;
 const kHourTolerance = 1e-3;
+const kTimeoutErrorCodes = new Set(['ECONNABORTED', 'ETIMEDOUT']);
+const kTimeoutTextPattern = /timeout|timed\s*out|time\s*out|超时/i;
+const kExceptionTextPattern = /exception|异常|系统错误|内部错误|internal\s+error|server\s+error/i;
+
+type AwardDeliveryResponse = {
+  st: number;
+  msg?: string;
+  code?: number;
+};
 
 function normalizeToHalfHour(value: number): number {
   const scaled = NP.times(value, kHalfHourScale);
@@ -29,3 +39,80 @@ export function hourToSecond(value?: number): number | undefined {
   const normalizedHour = normalizeToHalfHour(Number(value));
   return Math.round(NP.times(normalizedHour, kSecondsPerHour));
 }
+
+function toPlainRecord(value: unknown): Record<string, unknown> | undefined {
+  return value && typeof value === 'object' ? (value as Record<string, unknown>) : undefined;
+}
+
+function stringifyToken(value: unknown): string {
+  if (typeof value === 'string' || typeof value === 'number') {
+    return String(value);
+  }
+  return '';
+}
+
+function collectErrorText(error: unknown): string {
+  const record = toPlainRecord(error);
+  if (!record) {
+    return stringifyToken(error);
+  }
+
+  const response = toPlainRecord(record.response);
+  const data = toPlainRecord(response?.data);
+  return [
+    record.code,
+    record.name,
+    record.message,
+    record.msg,
+    response?.statusText,
+    data?.code,
+    data?.message,
+    data?.msg,
+  ]
+    .map(stringifyToken)
+    .filter(Boolean)
+    .join(' ');
+}
+
+export function isAwardDeliverySuccessResponse(res?: AwardDeliveryResponse): boolean {
+  return res?.st === 0 && res?.code === 0;
+}
+
+export function getAwardDeliveryResultCode(res?: AwardDeliveryResponse): number {
+  if (isAwardDeliverySuccessResponse(res)) {
+    return 0;
+  }
+  if (res?.code !== undefined && res.code !== 0) {
+    return res.code;
+  }
+  if (res?.st !== undefined && res.st !== 0) {
+    return res.st;
+  }
+  return -1;
+}
+
+export function isAwardDeliveryTimeoutLike(errorOrMessage: unknown): boolean {
+  const record = toPlainRecord(errorOrMessage);
+  const code = stringifyToken(record?.code);
+  return kTimeoutErrorCodes.has(code) || kTimeoutTextPattern.test(collectErrorText(errorOrMessage));
+}
+
+export function getAwardDeliveryResponseErrorMessage(
+  res: AwardDeliveryResponse,
+  fallbackMessage: string,
+): string {
+  if (isAwardDeliveryTimeoutLike(res.msg)) {
+    return MESSAGES.SEND_AWARD_GOVERNANCE_TIMEOUT;
+  }
+  if (kExceptionTextPattern.test(res.msg ?? '')) {
+    return MESSAGES.SEND_AWARD_GOVERNANCE_EXCEPTION;
+  }
+  const resultCode = getAwardDeliveryResultCode(res);
+  return `${fallbackMessage}: ${resultCode}, ${res.msg}`;
+}
+
+export function getAwardDeliveryExceptionMessage(error: unknown): string {
+  return isAwardDeliveryTimeoutLike(error)
+    ? MESSAGES.SEND_AWARD_GOVERNANCE_TIMEOUT
+    : MESSAGES.SEND_AWARD_GOVERNANCE_EXCEPTION;
+}
