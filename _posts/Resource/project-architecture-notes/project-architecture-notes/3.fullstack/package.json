{
    "name": "miaoma-fullstack",
    "version": "2.0.0",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "lint:js": "eslint .",
        "lint:ox:js": "oxlint .",
        "format": "prettier --write .",
        "spellcheck": "cspell lint --dot --gitignore --color --cache --show-suggestions \"(packages|apps)/**/*.@(html|js|cjs|mjs|ts|tsx|css|scss|md)\"",
        "commit": "git-cz",
        "prepare": "husky"
    },
    "config": {
        "commitizen": {
            "path": "node_modules/cz-git"
        }
    },
    "keywords": [],
    "author": "Heyi",
    "license": "ISC",
    "description": "",
    "devDependencies": {
        "@types/node": "22.9.0",
        "eslint": "9.39.0",
        "@eslint/js": "9.39.0",
        "globals": "16.5.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.46.2",
        "eslint-plugin-react-refresh": "0.4.24",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-prettier": "5.5.4",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "prettier": "3.6.2",
        "eslint-plugin-oxlint": "1.25.0",
        "oxlint": "1.25.0",
        "cspell": "9.2.2",
        "commitizen": "4.3.1",
        "cz-git": "1.12.0",
        "commitlint": "20.1.0",
        "@commitlint/config-conventional": "20.0.0",
        "husky": "9.1.7"
    }
}
