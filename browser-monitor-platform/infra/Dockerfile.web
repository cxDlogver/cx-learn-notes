FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /workspace
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY browser-monitor-protocol/package.json ./browser-monitor-protocol/package.json
COPY browser-monitor-sdk/package.json ./browser-monitor-sdk/package.json
COPY browser-monitor-platform/package.json ./browser-monitor-platform/package.json
COPY browser-monitor-platform/apps/api/package.json ./browser-monitor-platform/apps/api/package.json
COPY browser-monitor-platform/apps/worker/package.json ./browser-monitor-platform/apps/worker/package.json
COPY browser-monitor-platform/apps/web/package.json ./browser-monitor-platform/apps/web/package.json
COPY browser-monitor-platform/packages/database/package.json ./browser-monitor-platform/packages/database/package.json
COPY browser-monitor-platform/packages/shared/package.json ./browser-monitor-platform/packages/shared/package.json
RUN pnpm install --frozen-lockfile
COPY browser-monitor-platform/apps/web ./browser-monitor-platform/apps/web
RUN pnpm --filter @browser-monitor/web build

FROM caddy:2.10-alpine
COPY browser-monitor-platform/infra/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /workspace/browser-monitor-platform/apps/web/dist /srv

